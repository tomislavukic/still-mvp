{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "still-mvp",
  "compatibility_date": "2026-07-29",
  "main": "merchant-backend/worker-v107.js",
  // Build 107 is an operations hardening wrapper around merchant-backend/worker-v106.js.
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "still-production",
      "database_id": "2fce8b3f-ffb7-4ffe-8e11-b565a65ea655"
    }
  ]
}
