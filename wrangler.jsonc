{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "still-mvp",
  "compatibility_date": "2026-07-29",
  "main": "merchant-backend/worker-v141.js",
  // Active Worker fixes Professional Mode setup while preserving the full runtime chain.
  // worker-v141 delegates to worker-v140 and all prior Company Network, Market and Still OS layers.
  // Compatibility chain still includes merchant-backend/worker-v139.js -> worker-v138.js -> worker-v137.js -> worker-v136.js.
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/app", "/app/*", "/admin", "/admin/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "WORLD_FILES",
      "bucket_name": "still-private-world"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "still-production",
      "database_id": "2fce8b3f-ffb7-4ffe-8e11-b565a65ea655"
    }
  ]
}
