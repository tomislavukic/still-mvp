{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "still-mvp",
  "compatibility_date": "2026-07-29",
  "main": "merchant-backend/worker-v67.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "still-production",
      "database_id": "2fce8b3f-ffb7-4ffe-8e11-b565a65ea655"
    }
  ]
}