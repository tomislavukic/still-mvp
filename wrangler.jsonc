{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "still-mvp",
  "compatibility_date": "2026-07-29",
  "main": "merchant-backend/worker-v145.js",
  // Phase 9 adds Buyer-private Knowledge, authorized World search, document intelligence and evidence-grounded Ask Still.
  // worker-v145 is the active compatibility bridge and delegates to merchant-backend/worker-v144.js before the preserved Phase 8 chain.
  // Runtime remains additive: worker-v145 -> worker-v144 -> worker-v143 -> worker-v142 -> worker-v141 -> worker-v140 -> worker-v139 -> worker-v138 -> worker-v137 -> previous protected phases.
  // Historical phase guards intentionally reference preserved chain members: merchant-backend/worker-v144.js, merchant-backend/worker-v141.js and merchant-backend/worker-v139.js.
  "keep_vars": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "triggers": { "crons": ["17 3 * * *"] },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/app", "/app/*", "/admin", "/admin/*", "/service/*"] },
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "WORLD_FILES", "bucket_name": "still-private-world" }],
  "d1_databases": [{ "binding": "DB", "database_name": "still-production", "database_id": "2fce8b3f-ffb7-4ffe-8e11-b565a65ea655" }]
}
