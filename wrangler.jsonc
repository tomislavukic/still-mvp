{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "still-mvp",
  "compatibility_date": "2026-07-29",
  "main": "merchant-backend/worker-v140.js",
  // Active Worker modernizes Stripe Connect to Accounts v2 merchant accounts
  // while preserving Company Network, services, Market, Still OS and CompanyOS APIs.
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/app", "/app/*", "/admin", "/admin/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "WORLD_FILES",
      "bucket_name": "still-private-world"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "still-production",
      "database_id": "2fce8b3f-ffb7-4ffe-8e11-b565a65ea655"
    }
  ]
}